# =========================================================================
# India Temple Heritage & Pilgrimage Information Portal
# Official Environment Configuration
# Strictly adhering to: Node.js, Express.js, MongoDB / PostgreSQL
# =========================================================================

# Application Server Port
PORT=5000
NODE_ENV=development

# JWT Secret for Administrative Authentication
JWT_SECRET=bharat_teerth_sacred_heritage_portal_jwt_secret_2026

# -------------------------------------------------------------------------
# OPTION 1: MongoDB Database (Mongoose)
# -------------------------------------------------------------------------
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/temple_heritage
# MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/temple_heritage?retryWrites=true&w=majority

# -------------------------------------------------------------------------
# OPTION 2: PostgreSQL Database (pg)
# -------------------------------------------------------------------------
# Connection String format:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/temple_heritage
# Or Individual Parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=password
# PGDATABASE=temple_heritage
# PGSSL=false

# (If neither MONGODB_URI nor DATABASE_URL is set, the portal utilizes its
# internal high-performance structured document store pre-seeded with all
# 100 authentic shrines across all 35 States & UTs for instant zero-friction execution)

